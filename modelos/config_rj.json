  "documento": "<article class=\"folha-doc\">\n<section class=\"card-bloco\" data-grupo=\"Formulário\"><header class=\"card-bloco-cabecalho\"><h3>Formulário</h3></header><div class=\"card-bloco-corpo\"><div style=\"text-align: center;\"><b>Governo do Estado de São Paulo</b></div><div style=\"text-align: center;\"><b>Companhia&nbsp; de Processamento de Dados do Estado de São Paulo</b></div><div style=\"text-align: center;\"><br></div><div style=\"text-align: center;\"><br></div><div style=\"text-align: center;\"><b>JUSTIFICATIVA DE OS</b></div><div style=\"text-align: center;\"><b><br></b></div><div style=\"text-align: center;\"><b><br></b></div><div style=\"text-align: left;\"><b>Número Processo SEI:&nbsp;&nbsp;{{numero_sei}}</b></div><div style=\"text-align: left;\"><b>ID do Relatório:&nbsp; &nbsp;{{id_relatorio}}</b></div><div style=\"text-align: left;\"><b>Número SOW:&nbsp;&nbsp;{{n_sow}}</b></div><div style=\"text-align: left;\"><b>Diretoria:&nbsp;&nbsp;{{diretoria}}</b></div><div style=\"text-align: left;\"><b>Superintendência:&nbsp;&nbsp;{{superintendencia}}</b></div><div style=\"text-align: left;\"><b>Gerência:&nbsp;&nbsp;{{gerencia}}</b></div><div style=\"text-align: left;\"><b>Matrícula Gerente:&nbsp;&nbsp;{{matricula_gerente}}</b></div><div style=\"text-align: left;\"><b>Nome Gerente:&nbsp;&nbsp;{{nome_gerente}}</b></div><div style=\"text-align: left;\"><b>E-mail Gerente:&nbsp;&nbsp;{{email_gerente}}</b></div><div style=\"text-align: left;\"><b>Número do Contrato:&nbsp;&nbsp;{{numero_contrato}}</b></div><div style=\"text-align: left;\"><b>Fornecedor:&nbsp;&nbsp;{{fornecedor}}</b></div><div style=\"text-align: left;\"><b>Data Fim Vigência:&nbsp;&nbsp;{{data_fim_vigencia}}</b></div><div style=\"text-align: left;\"><b>Objeto e Descrição dos Serviços/Atividades:&nbsp;&nbsp;{{objeto_descricao_atividades}}</b></div><div style=\"text-align: left;\"><b>Local de Execução:&nbsp;&nbsp;{{local_execucao}}</b></div><div style=\"text-align: left;\"><b>Endereço de Execuçã